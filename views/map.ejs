<%- include('partials/header') %>

<link
  href="https://api.mapbox.com/mapbox-gl-js/v3.13.0/mapbox-gl.css"
  rel="stylesheet"
/>

<link rel="stylesheet" href="/css/map.css" />

<div id="map"></div>

<!-- Retractable ping radius panel -->
<div id="radius-panel">
  <button id="radius-toggle" title="Filter radius">&#x2039;</button>
  <div id="radius-content">
    <div>
      <label for="radius-input"> Ping Radius (km) </label>
      <input
        id="radius-input"
        type="number"
        min="0.5"
        max="500"
        step="0.5"
        value="5"
        placeholder="example: 10"
      />
    </div>
    <button id="radius-apply">Apply and Rescan</button>
  </div>
</div>

<!-- First time map page popup — must be BEFORE footer closes the body -->
<div id="mapFirstTimePopup" style="display: none" class="popup-overlay">
  <div class="popup-content">
    <h2>Grocery Map</h2>
    <p>This map shows nearby grocery stores based on your location.</p>
    <ul>
      <li>Green markers are stores near you</li>
      <li>Tap a marker for the store name and address</li>
      <li>Use the arrow panel on the right to set how far to scan</li>
    </ul>
    <button id="closeMapPopup">Got It!</button>
  </div>
</div>

<script>
  const MAPBOX_TOKEN = "<%= mapboxToken %>";
</script>

<!-- AI assisted to help get the API -->
<script src="https://api.mapbox.com/mapbox-gl-js/v3.13.0/mapbox-gl.js"></script>

<%- include('partials/footer') %>
