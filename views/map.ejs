<%- include('partials/header') %>

<link
  href="https://api.mapbox.com/mapbox-gl-js/v3.13.0/mapbox-gl.css"
  rel="stylesheet"
/>

<link rel="stylesheet" href="/css/map.css" />

<div id="map">
  <!-- Retractable ping radius panel -->
  <div id="radius-panel">
    <button id="radius-toggle" title="Filter radius">&#x2039;</button>
    <div id="radius-content">
      <div>
        <label for="radius-input"> Ping Radius (km) </label>
        <input
          id="radius-input"
          type="number"
          min="0.5"
          max="500"
          step="0.5"
          value="5"
          placeholder="example: 10"
        />
      </div>
      <button id="radius-apply">Apply and Rescan</button>
    </div>
  </div>
</div>

<script>
  const MAPBOX_TOKEN = "<%= mapboxToken %>";
</script>

<!-- AI assisted to help get the API -->
<script src="https://api.mapbox.com/mapbox-gl-js/v3.13.0/mapbox-gl.js"></script>

<script src="/map.js"></script>

<%- include('partials/footer') %>
