<%- include('partials/header') %>

  <main class="main">

    <div class="body_container login_card" id="login_container">
      <form id="loginForm" action="/loginSubmit" method="POST" class="edit_details">
        <span class="info">Email</span>
        <input type="email" class="login_input" placeholder="Email" name="email" required />

        <span class="info">Password</span>
        <input type="password" class="login_input" placeholder="Password" name="password" required />
      </form>

      <button type="submit" form="loginForm" class="signout login_button">
        Log In
      </button>

      <p class="switch_text">
        Don't have an account?
        <span class="switch_link" onclick="showSignup()">Sign Up</span>
      </p>
    </div>

    <div class="body_container login_card" id="signup_container" style="display: none;">
      <form id="signupForm" action="/signupSubmit" method="POST" class="edit_details">
        <span class="info">Name</span>
        <input type="text" class="login_input" placeholder="Name" name="name" required />

        <span class="info">Email</span>
        <input type="email" class="login_input" placeholder="Email" name="email" required />

        <span class="info">Password</span>
        <input type="password" class="login_input" placeholder="Password" name="password" required />
      </form>

      <button type="submit" form="signupForm" class="signout login_button">
        Sign Up
      </button>

      <p class="switch_text">
        Already have an account?
        <span class="switch_link" onclick="showLogin()">Log In</span>
      </p>
    </div>
  </main>

  <div id="firstTimePopup" style="display: none;" class="popup-overlay">
    <div class="popup-content">
      <h2>Welcome!</h2>
      <p>Log in or create an account to save recipes and locations.</p>
      <button id="closePopup">Got It!</button>
    </div>
  </div>

  <script src="/login.js"></script>

  <%- include('partials/footer') %>
