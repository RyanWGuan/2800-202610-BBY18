<%- include("partials/header", { cssFiles: ["style", "recipe"] }) %>

<main class="main">
    <div class="results" id="results">

        <% if (savedRecipes.length === 0) { %>
            <p>No saved recipes yet.</p>
        <% } %>

        <% savedRecipes.forEach((recipe) => { %>
            <a href="/recipeDetails?id=<%= recipe.id %>" class="card-link">
                <div class="card">
                    <img src="<%= recipe.image %>" alt="<%= recipe.name %>" class="card-img"/>

                    <div class="card-meta">
                        <h3 class="card-title"><%= recipe.name %></h3>

                        <div class="card-bottom">
                            <span class="price-label">$10.49</span>

                        <button 
                            class="delete_recipe_button"
                            onclick="deleteSavedRecipe(event, '<%= recipe._id %>')"
                        >
                        Delete
                            </button>
                        </div>
                    </div>
                </div>
            </a>
        <% }) %>

    </div>
</main>

<div id="savedRecipesPopup" style="display: none;" class="popup-overlay">
    <div class="popup-content">
        <h2>Saved Recipes Page</h2>
        <p>
            Here, you can view the recipes you saved and quickly access them later.
        </p>
        <button id="closeSavedRecipesPopup">Got It!</button>
    </div>
</div>

<script src="/js/savedRecipes.js"></script>

<%- include("partials/footer") %>