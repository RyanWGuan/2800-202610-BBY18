<%- include('partials/header') %>

<main class="main">
  <div id="firstTimePopup" style="display: none" class="popup-overlay">
    <div class="popup-content">
      <h2>Shopping List</h2>
      <p>
        Check off ingredients as you shop. Use "Clear completed" to remove
        checked items.
      </p>
      <button id="closePopup">Got It!</button>
    </div>
  </div>

  <div class="shopping-list">
    <h1>Shopping List</h1>
    <div id="shopping-list-container">
      <p>Loading...</p>
    </div>
    <button class="ai-store-btn" onclick="findNearbyStores()">
      Find Nearby Stores for My List
    </button>
    <button class="clear-btn" onclick="clearCompleted()">
      Clear completed
    </button>
  </div>
</main>

<%- include('partials/footer') %>
